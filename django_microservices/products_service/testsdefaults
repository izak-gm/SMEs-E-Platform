Best Practices for Serializer Tests
1. Test Validation Rules
python
def test_custom_validator(self):
    """Test custom validation method"""
    data = {'field': 'invalid_value'}
    serializer = MySerializer(data=data)
    self.assertFalse(serializer.is_valid())
    self.assertIn('field', serializer.errors)
2. Test Create and Update
python
def test_create_with_relations(self):
    """Test creating with foreign keys"""
    serializer = MySerializer(data=data)
    self.assertTrue(serializer.is_valid())
    instance = serializer.save()
    self.assertEqual(instance.related_field.id, expected_id)

def test_update_partial(self):
    """Test partial update"""
    serializer = MySerializer(instance, data={'field': 'new'}, partial=True)
    self.assertTrue(serializer.is_valid())
    instance = serializer.save()
    self.assertEqual(instance.field, 'new')
3. Test Read-Only Fields
python
def test_read_only_fields(self):
    """Test read-only fields are not saved"""
    data = serializer.data
    data['read_only_field'] = 'hacked_value'
    serializer = MySerializer(instance, data=data, partial=True)
    self.assertTrue(serializer.is_valid())
    saved = serializer.save()
    self.assertNotEqual(saved.read_only_field, 'hacked_value')
4. Test Field-Level Validation
python
def test_field_validators(self):
    """Test field validators"""
    # Test each validator separately
    invalid_values = ['', None, ' ']
    for value in invalid_values:
        with self.subTest(value=value):
            serializer = MySerializer(data={'field': value})
            self.assertFalse(serializer.is_valid())
5. Test Context
python
def test_serializer_with_context(self):
    """Test serializer receives context"""
    context = {'request': request, 'user': user}
    serializer = MySerializer(data=data, context=context)
    self.assertTrue(serializer.is_valid())
    # Verify context was used in validation