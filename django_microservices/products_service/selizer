# Helper mixin for UUID tests
class UUIDTestMixin:
    """Mixin with common UUID test helpers"""

    def assertIsValidUUID(self, value, msg=None):
        """Assert that value is a valid UUID string"""
        try:
            uuid.UUID(value)
        except (ValueError, AttributeError, TypeError):
            raise AssertionError(f"{value} is not a valid UUID")

    def assertUUIDEqual(self, uuid1, uuid2, msg=None):
        """Assert two UUIDs are equal (accepts string or UUID objects)"""
        if isinstance(uuid1, str):
            uuid1 = uuid.UUID(uuid1)
        if isinstance(uuid2, str):
            uuid2 = uuid.UUID(uuid2)
        self.assertEqual(uuid1, uuid2, msg)

    def get_uuid_string(self, uuid_obj):
        """Convert UUID to string safely"""
        if isinstance(uuid_obj, uuid.UUID):
            return str(uuid_obj)
        return uuid_obj


# Apply mixin to test classes
class EnhancedProductSerializerTest(UUIDTestMixin, TestCase):
    """Product serializer tests with UUID mixin"""

    def setUp(self):
        self.user = User.objects.create_user(id=1, username='seller')
