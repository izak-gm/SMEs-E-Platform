class StoreSerializerTest(TestCase):
    """Test Store Serializer with UUID"""

    def setUp(self):
        self.user = User.objects.create_user(
            id=1,  # This might still be integer PK
            username='seller',
            password='testpass123'
        )
        self.serializer_data = {
            'name': 'Test Store',
            'description': 'Test Description',
            'owner': self.user.id,
            'status': 'pending'
        }

    def test_uuid_is_generated_automatically(self):
        """Test UUID is auto-generated on creation"""
        store = Store.objects.create(
            name='Store',
            owner=self.user,
            status=Store.Status.PENDING
        )

        # Check that id is a UUID
        self.assertIsInstance(store.id, uuid.UUID)
        self.assertNotEqual(store.id, uuid.UUID(int=0))  # Not empty

        # Check string representation
        self.assertEqual(len(str(store.id)), 36)  # UUID format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

    def test_serializer_handles_uuid_correctly(self):
        """Test serializer correctly serializes UUID fields"""
        store = Store.objects.create(
            name='Store',
            owner=self.user,
            status=Store.Status.PENDING
        )

        serializer = StoreSerializer(store)
        data = serializer.data

        # UUID should be serialized as string
        self.assertIn('id', data)
        self.assertIsInstance(data['id'], str)

        # Try to parse it back to UUID
        try:
            uuid.UUID(data['id'])
            is_valid_uuid = True
        except ValueError:
            is_valid_uuid = False
        self.assertTrue(is_valid_uuid)

        # Verify it's the same UUID
        self.assertEqual(str(store.id), data['id'])

    def test_create_store_without_providing_uuid(self):
        """Test creating store doesn't require UUID in request"""
        serializer = StoreSerializer(data=self.serializer_data)
        self.assertTrue(serializer.is_valid())

        store = serializer.save()

        # UUID should be auto-generated
        self.assertIsNotNone(store.id)
        self.assertIsInstance(store.id, uuid.UUID)

        # Verify UUID is not in validated_data (should be read-only)
        self.assertNotIn('id', serializer.validated_data)

    def test_cannot_set_uuid_manually(self):
        """Test UUID is read-only and cannot be set via serializer"""
        custom_uuid = uuid.uuid4()
        self.serializer_data['id'] = str(custom_uuid)

        serializer = StoreSerializer(data=self.serializer_data)
        self.assertTrue(serializer.is_valid())

        # id should be ignored (not in validated_data)
        self.assertNotIn('id', serializer.validated_data)

        store = serializer.save()
        # Store should have a different auto-generated UUID
        self.assertNotEqual(str(store.id), str(custom_uuid))

    def test_update_store_preserves_uuid(self):
        """Test updating store doesn't change UUID"""
        original_store = Store.objects.create(
            name='Original',
            owner=self.user,
            status=Store.Status.PENDING
        )
        original_uuid = original_store.id

        # Update store
        serializer = StoreSerializer(
            instance=original_store,
            data={'name': 'Updated Name'},
            partial=True
        )
        self.assertTrue(serializer.is_valid())
        updated_store = serializer.save()

        # UUID should remain the same
        self.assertEqual(updated_store.id, original_uuid)
        self.assertEqual(str(updated_store.id), str(original_uuid))

    def test_lookup_by_uuid(self):
        """Test retrieving store by UUID"""
        store = Store.objects.create(
            name='Store',
            owner=self.user,
            status=Store.Status.PENDING
        )

        # Convert UUID to string for lookup
        store_uuid_str = str(store.id)

        # Lookup using string representation
        retrieved_store = Store.objects.get(id=store_uuid_str)
        self.assertEqual(retrieved_store.id, store.id)

        # Lookup using UUID object
        retrieved_store = Store.objects.get(id=store.id)
        self.assertEqual(retrieved_store.name, 'Store')


class ProductSerializerTest(TestCase):
    """Test Product Serializer with UUID"""

    def setUp(self):
        self.user = User.objects.create_user(
            id=1,
            username='seller',
            password='testpass123'
        )
        self.store = Store.objects.create(
            name='Test Store',
            owner=self.user,
            status=Store.Status.ACTIVE
        )
        self.brand = Brand.objects.create(
            name='Test Brand',
            description='Brand Desc'
        )
        self.category = Category.objects.create(
            name='Electronics',
            slug='electronics'
        )

        self.serializer_data = {
            'name': 'iPhone 13',
            'description': 'Latest iPhone',
            'price': '999.99',
            'stock': 50,
            'store': str(self.store.id),  # Convert UUID to string
            'brand': self.brand.id,       # Might be integer PK
            'category': self.category.id
        }

    def test_uuid_foreign_key_handling(self):
        """Test serializer handles UUID foreign keys"""
        serializer = ProductSerializer(data=self.serializer_data)
        self.assertTrue(serializer.is_valid())

        # Store ID in validated_data should be UUID or the model instance
        self.assertIn('store', serializer.validated_data)

        product = serializer.save()
        self.assertEqual(product.store.id, self.store.id)

    def test_uuid_foreign_key_string_input(self):
        """Test UUID foreign key accepts string representation"""
        # Pass store ID as string
        self.serializer_data['store'] = str(self.store.id)

        serializer = ProductSerializer(data=self.serializer_data)
        self.assertTrue(serializer.is_valid())

        product = serializer.save()
        self.assertEqual(product.store, self.store)

    def test_uuid_foreign_key_uuid_object_input(self):
        """Test UUID foreign key accepts UUID object"""
        # Pass store ID as UUID object
        self.serializer_data['store'] = self.store.id

        serializer = ProductSerializer(data=self.serializer_data)
        self.assertTrue(serializer.is_valid())

        product = serializer.save()
        self.assertEqual(product.store, self.store)

    def test_invalid_uuid_format(self):
        """Test error with invalid UUID format"""
        self.serializer_data['store'] = 'invalid-uuid-format'

        serializer = ProductSerializer(data=self.serializer_data)
        self.assertFalse(serializer.is_valid())
        self.assertIn('store', serializer.errors)
        self.assertIn('UUID', str(serializer.errors['store'][0]))

    def test_nonexistent_uuid(self):
        """Test error with valid UUID format but non-existent record"""
        non_existent_uuid = uuid.uuid4()
        self.serializer_data['store'] = str(non_existent_uuid)

        serializer = ProductSerializer(data=self.serializer_data)
        self.assertFalse(serializer.is_valid())
        self.assertIn('store', serializer.errors)
        self.assertEqual(
            serializer.errors['store'][0].code,
            'does_not_exist'
        )

    def test_product_serialization_includes_uuid(self):
        """Test product serializer includes UUID in response"""
        product = Product.objects.create(
            name='Test Product',
            description='Desc',
            price=100,
            stock=10,
            store=self.store,
            brand=self.brand,
            category=self.category
        )

        serializer = ProductSerializer(product)
        data = serializer.data

        # Product ID should be UUID
        self.assertIn('id', data)
        self.assertIsInstance(data['id'], str)

        # Verify it's valid UUID
        uuid.UUID(data['id'])

        # Store should be nested with its UUID
        self.assertIn('store', data)
        self.assertIsInstance(data['store']['id'], str)
        uuid.UUID(data['store']['id'])

    def test_filter_products_by_store_uuid(self):
        """Test filtering products by store UUID"""
        product1 = Product.objects.create(
            name='Product 1',
            description='Desc',
            price=100,
            stock=10,
            store=self.store,
            brand=self.brand,
            category=self.category
        )

        # In view test, you'd use: /products/?store={store_uuid}
        # Here we just test the queryset filtering
        products = Product.objects.filter(store_id=self.store.id)
        self.assertEqual(products.count(), 1)
        self.assertEqual(products.first().id, product1.id)


