class NestedSerializerWithUUIDTest(TestCase):
    """Test nested serialization with UUID fields"""

    def setUp(self):
        self.user = User.objects.create_user(id=1, username='seller')
        self.store = Store.objects.create(
            name='Store',
            owner=self.user,
            status=Store.Status.ACTIVE
        )
        self.product = Product.objects.create(
            name='Product',
            description='Desc',
            price=100,
            stock=10,
            store=self.store,
            brand=Brand.objects.create(name='Brand'),
            category=Category.objects.create(name='Category', slug='cat')
        )

    def test_nested_store_serialization_with_uuid(self):
        """Test nested store includes UUID"""
        serializer = ProductSerializer(self.product)
        data = serializer.data

        # Check nested store object
        self.assertIn('store', data)
        self.assertIsInstance(data['store']['id'], str)
        uuid.UUID(data['store']['id'])

        # Check nested brand (if brand uses integer PK)
        self.assertIn('brand', data)
        if hasattr(self.product.brand, 'id'):
            # Brand might have integer PK
            self.assertIsNotNone(data['brand']['id'])

    def test_serialize_with_uuids_in_list(self):
        """Test serializing multiple objects with UUIDs"""
        products = [
            Product.objects.create(
                name=f'Product {i}',
                description='Desc',
                price=100,
                stock=10,
                store=self.store,
                brand=Brand.objects.create(name=f'Brand {i}'),
                category=Category.objects.create(name=f'Cat {i}', slug=f'cat{i}')
            )
            for i in range(5)
        ]

        serializer = ProductSerializer(products, many=True)
        data = serializer.data

        self.assertEqual(len(data), 5)
        for item in data:
            # Each product should have valid UUID
            self.assertIn('id', item)
            uuid.UUID(item['id'])

            # Each store in product should have UUID
            uuid.UUID(item['store']['id'])


class CustomUUIDValidationTest(TestCase):
    """Test custom UUID validation scenarios"""

    def setUp(self):
        self.user = User.objects.create_user(id=1, username='seller')
        self.store = Store.objects.create(
            name='Store',
            owner=self.user,
            status=Store.Status.ACTIVE
        )

    def test_empty_uuid_string(self):
        """Test handling of empty UUID string"""
        serializer = ProductSerializer(data={
            'name': 'Product',
            'description': 'Desc',
            'price': '100',
            'stock': 10,
            'store': '',  # Empty string
            'brand': 1,
            'category': 1
        })

        self.assertFalse(serializer.is_valid())
        self.assertIn('store', serializer.errors)

    def test_none_uuid_value(self):
        """Test handling of None for UUID field"""
        serializer = ProductSerializer(data={
            'name': 'Product',
            'description': 'Desc',
            'price': '100',
            'stock': 10,
            'store': None,
            'brand': 1,
            'category': 1
        })

        self.assertFalse(serializer.is_valid())
        self.assertIn('store', serializer.errors)

    def test_uuid_with_whitespace(self):
        """Test UUID with whitespace"""
        store_uuid_with_spaces = f" {str(self.store.id)} "

        serializer = ProductSerializer(data={
            'name': 'Product',
            'description': 'Desc',
            'price': '100',
            'stock': 10,
            'store': store_uuid_with_spaces,
            'brand': 1,
            'category': 1
        })

        # DRF usually strips whitespace automatically
        self.assertTrue(serializer.is_valid())

    def test_case_sensitivity(self):
        """Test UUID case insensitivity"""
        # UUIDs are case-insensitive in string representation
        store_uuid_upper = str(self.store.id).upper()
        store_uuid_lower = str(self.store.id).lower()

        self.assertEqual(store_uuid_upper, store_uuid_lower.upper())

        # Both should work
        serializer1 = ProductSerializer(data={
            'name': 'Product 1',
            'description': 'Desc',
            'price': '100',
            'stock': 10,
            'store': store_uuid_upper,
            'brand': 1,
            'category': 1
        })

        serializer2 = ProductSerializer(data={
            'name': 'Product 2',
            'description': 'Desc',
            'price': '100',
            'stock': 10,
            'store': store_uuid_lower,
            'brand': 1,
            'category': 1
        })

        self.assertTrue(serializer1.is_valid())
        self.assertTrue(serializer2.is_valid())


