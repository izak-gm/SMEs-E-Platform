class ProductImageViewSetTestCase(BaseTestCase):
    """Tests for Product Image ViewSet"""

    def setUp(self):
        super().setUp()
        from django.core.files.uploadedfile import SimpleUploadedFile

        self.test_image = SimpleUploadedFile(
            "test_image.jpg",
            b"file_content",
            content_type="image/jpeg"
        )

    def authenticate_as(self, user):
        self.client.force_authenticate(user=user)

    def test_seller_can_add_image_to_product(self):
        """Test that sellers can add images to their products"""
        self.authenticate_as(self.seller_user)
        url = reverse('productimage-list')
        data = {
            'product': self.product.id,
            'image': self.test_image,
            'is_primary': False
        }
        response = self.client.post(url, data, format='multipart')
        self.assertEqual(response.status_code, status.HTTP_201_CREATED)
        self.assertEqual(ProductImage.objects.filter(product=self.product).count(), 2)

    def test_seller_cannot_add_image_to_other_product(self):
        """Test that sellers cannot add images to others' products"""
        self.authenticate_as(self.seller_user)
        url = reverse('productimage-list')
        data = {
            'product': self.other_product.id,
            'image': self.test_image,
            'is_primary': False
        }
        response = self.client.post(url, data, format='multipart')
        self.assertEqual(response.status_code, status.HTTP_404_NOT_FOUND)

    def test_only_one_primary_image_per_product(self):
        """Test that setting a new primary image updates the old one"""
        self.authenticate_as(self.seller_user)

        # Create new image as primary
        new_image = ProductImage.objects.create(
            product=self.product,
            image='new_image.jpg',
            is_primary=True
        )

        # Old primary should be False now
        self.product_image.refresh_from_db()
        self.assertFalse(self.product_image.is_primary)
        self.assertTrue(new_image.is_primary)


