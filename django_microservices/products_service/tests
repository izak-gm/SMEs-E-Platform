class EdgeCaseTestCase(BaseTestCase):
    """Test edge cases and error handling"""

    def test_get_nonexistent_product(self):
        """Test retrieving a non-existent product"""
        url = reverse('product-detail', args=[99999])
        response = self.client.get(url)
        self.assertEqual(response.status_code, status.HTTP_404_NOT_FOUND)

    def test_create_product_with_negative_price(self):
        """Test validation for negative price"""
        self.authenticate_as(self.seller_user)
        url = reverse('product-list')
        data = {
            'name': 'Invalid Product',
            'description': 'Description',
            'price': '-10.00',
            'stock': 10,
            'store': self.store.id,
            'brand': self.brand.id,
            'category': self.category.id
        }
        response = self.client.post(url, data)
        self.assertEqual(response.status_code, status.HTTP_400_BAD_REQUEST)
        self.assertIn('price', response.data)

    def test_create_product_with_negative_stock(self):
        """Test validation for negative stock"""
        self.authenticate_as(self.seller_user)
        url = reverse('product-list')
        data = {
            'name': 'Invalid Stock Product',
            'description': 'Description',
            'price': '99.99',
            'stock': -5,
            'store': self.store.id,
            'brand': self.brand.id,
            'category': self.category.id
        }
        response = self.client.post(url, data)
        self.assertEqual(response.status_code, status.HTTP_400_BAD_REQUEST)

    def test_duplicate_sku_validation(self):
        """Test that SKU must be unique"""
        self.authenticate_as(self.seller_user)
        url = reverse('productvariant-list')
        data = {
            'product': self.product.id,
            'sku': 'TEST-SKU-001',  # Already exists
            'price': '99.99',
            'stock': 5,
            'attributes': {}
        }
        response = self.client.post(url, data)
        self.assertEqual(response.status_code, status.HTTP_400_BAD_REQUEST)
        self.assertIn('sku', response.data)