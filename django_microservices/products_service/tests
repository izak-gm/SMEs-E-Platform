class BaseTestCase(TestCase):
    """Base test class with common setup"""

    def setUp(self):
        self.client = APIClient()

        # Create users with different roles
        self.admin_user = User.objects.create_user(
            id=1,
            username='admin',
            email='admin@example.com',
            password='adminpass123',
            role='admin'
        )

        self.seller_user = User.objects.create_user(
            id=2,
            username='seller',
            email='seller@example.com',
            password='sellerpass123',
            role='seller'
        )

        self.other_seller = User.objects.create_user(
            id=3,
            username='other_seller',
            email='other@example.com',
            password='otherpass123',
            role='seller'
        )

        self.customer_user = User.objects.create_user(
            id=4,
            username='customer',
            email='customer@example.com',
            password='customerpass123',
            role='customer'
        )

        # Create test data
        self.brand = Brand.objects.create(
            name='Test Brand',
            description='Test Description'
        )

        self.category = Category.objects.create(
            name='Electronics',
            slug='electronics'
        )

        self.store = Store.objects.create(
            name='Test Store',
            owner=self.seller_user,
            status=Store.Status.ACTIVE
        )

        self.product = Product.objects.create(
            name='Test Product',
            description='Test Description',
            price=Decimal('99.99'),
            stock=10,
            store=self.store,
            brand=self.brand,
            category=self.category
        )

        self.variant = ProductVariant.objects.create(
            product=self.product,
            sku='TEST-SKU-001',
            price=Decimal('109.99'),
            stock=5,
            attributes={'color': 'red', 'size': 'M'}
        )

        self.product_image = ProductImage.objects.create(
            product=self.product,
            image='test_image.jpg',
            is_primary=True
        )


class StoreViewSetTestCase(BaseTestCase):
    """Tests for Store ViewSet"""

    def setUp(self):
        super().setUp()

        # Create pending store for approval tests
        self.pending_store = Store.objects.create(
            name='Pending Store',
            owner=self.seller_user,
            status=Store.Status.PENDING
        )

    def authenticate_as(self, user):
        """Helper method to authenticate as different users"""
        # Mock JWT authentication - adjust based on your JWT implementation
        self.client.force_authenticate(user=user)

    def test_unauthenticated_cannot_create_store(self):
        """Test that unauthenticated users cannot create stores"""
        url = reverse('store-list')
        data = {
            'name': 'New Store',
            'description': 'Store Description'
        }
        response = self.client.post(url, data)
        self.assertEqual(response.status_code, status.HTTP_401_UNAUTHORIZED)

    def test_seller_can_create_store(self):
        """Test that sellers can create stores"""
        self.authenticate_as(self.seller_user)
        url = reverse('store-list')
        data = {
            'name': 'Seller Store',
            'description': 'My Awesome Store',
            'owner': self.seller_user.id
        }
        response = self.client.post(url, data)
        self.assertEqual(response.status_code, status.HTTP_201_CREATED)
        self.assertEqual(Store.objects.filter(name='Seller Store').count(), 1)
        store = Store.objects.get(name='Seller Store')
        self.assertEqual(store.owner_id, self.seller_user.id)

    def test_customer_cannot_create_store(self):
        """Test that customers cannot create stores"""
        self.authenticate_as(self.customer_user)
        url = reverse('store-list')
        data = {
            'name': 'Customer Store',
            'description': 'Store Description'
        }
        response = self.client.post(url, data)
        self.assertEqual(response.status_code, status.HTTP_403_FORBIDDEN)

    def test_admin_can_approve_store(self):
        """Test that admin can approve pending stores"""
        self.authenticate_as(self.admin_user)
        url = reverse('store-approve', args=[self.pending_store.id])
        response = self.client.post(url)
        self.assertEqual(response.status_code, status.HTTP_200_OK)

        self.pending_store.refresh_from_db()
        self.assertEqual(self.pending_store.status, Store.Status.ACTIVE)

    def test_approve_already_active_store(self):
        """Test approving already active store returns error"""
        self.authenticate_as(self.admin_user)
        url = reverse('store-approve', args=[self.store.id])
        response = self.client.post(url)
        self.assertEqual(response.status_code, status.HTTP_400_BAD_REQUEST)
        self.assertIn('Already Approved', response.data['message'])

    def test_non_admin_cannot_approve_store(self):
        """Test that non-admin users cannot approve stores"""
        self.authenticate_as(self.seller_user)
        url = reverse('store-approve', args=[self.pending_store.id])
        response = self.client.post(url)
        self.assertEqual(response.status_code, status.HTTP_403_FORBIDDEN)

    def test_seller_can_view_own_store(self):
        """Test that sellers can view their own store"""
        self.authenticate_as(self.seller_user)
        url = reverse('store-detail', args=[self.store.id])
        response = self.client.get(url)
        self.assertEqual(response.status_code, status.HTTP_200_OK)
        self.assertEqual(response.data['name'], 'Test Store')

    def test_list_stores(self):
        """Test listing all stores"""
        self.authenticate_as(self.customer_user)
        url = reverse('store-list')
        response = self.client.get(url)
        self.assertEqual(response.status_code, status.HTTP_200_OK)
        self.assertEqual(len(response.data), 2)  # Test Store + Pending Store


class ProductViewSetTestCase(BaseTestCase):
