    def test_anyone_can_view_products(self):
        """Test that unauthenticated users can view products"""
        url = reverse('product-list')
        response = self.client.get(url)
        self.assertEqual(response.status_code, status.HTTP_200_OK)
        self.assertEqual(len(response.data), 2)

    def test_anyone_can_view_single_product(self):
        """Test that unauthenticated users can view a single product"""
        url = reverse('product-detail', args=[self.product.id])
        response = self.client.get(url)
        self.assertEqual(response.status_code, status.HTTP_200_OK)
        self.assertEqual(response.data['name'], 'Test Product')

    def test_seller_can_create_product(self):
        """Test that sellers can create products"""
        self.authenticate_as(self.seller_user)
        url = reverse('product-list')
        data = {
            'name': 'New Product',
            'description': 'New Description',
            'price': '149.99',
            'stock': 15,
            'store': self.store.id,
            'brand': self.brand.id,
            'category': self.category.id
        }
        response = self.client.post(url, data)
        self.assertEqual(response.status_code, status.HTTP_201_CREATED)
        self.assertEqual(Product.objects.filter(name='New Product').count(), 1)

    def test_customer_cannot_create_product(self):
        """Test that customers cannot create products"""
        self.authenticate_as(self.customer_user)
        url = reverse('product-list')
        data = {
            'name': 'Customer Product',
            'description': 'Description',
            'price': '99.99',
            'stock': 10,
            'store': self.store.id,
            'brand': self.brand.id,
            'category': self.category.id
        }
        response = self.client.post(url, data)
        self.assertEqual(response.status_code, status.HTTP_403_FORBIDDEN)

    def test_seller_can_update_own_product(self):
        """Test that sellers can update their own products"""
        self.authenticate_as(self.seller_user)
        url = reverse('product-detail', args=[self.product.id])
        data = {'name': 'Updated Product Name', 'price': '129.99'}
        response = self.client.patch(url, data)
        self.assertEqual(response.status_code, status.HTTP_200_OK)

        self.product.refresh_from_db()
        self.assertEqual(self.product.name, 'Updated Product Name')
        self.assertEqual(self.product.price, Decimal('129.99'))

    def test_seller_cannot_update_other_seller_product(self):
        """Test that sellers cannot update products from other sellers"""
        self.authenticate_as(self.seller_user)
        url = reverse('product-detail', args=[self.other_product.id])
        data = {'name': 'Hacked Name'}
        response = self.client.patch(url, data)
        self.assertEqual(response.status_code, status.HTTP_404_NOT_FOUND)

    def test_seller_can_delete_own_product(self):
        """Test that sellers can delete their own products"""
        self.authenticate_as(self.seller_user)
        url = reverse('product-detail', args=[self.product.id])
        response = self.client.delete(url)
        self.assertEqual(response.status_code, status.HTTP_204_NO_CONTENT)
        self.assertEqual(Product.objects.filter(id=self.product.id).count(), 0)

    def test_filter_products_by_category(self):
        """Test filtering products by category"""
        url = reverse('product-list')
        response = self.client.get(url, {'category': self.category.id})
        self.assertEqual(response.status_code, status.HTTP_200_OK)
        self.assertEqual(len(response.data), 2)

        # Create new category
        new_category = Category.objects.create(name='Books', slug='books')
        url = reverse('product-list')
        response = self.client.get(url, {'category': new_category.id})
        self.assertEqual(len(response.data), 0)

    def test_filter_products_by_price_range(self):
        """Test filtering products by price range"""
        url = reverse('product-list')
        response = self.client.get(url, {'min_price': 50, 'max_price': 100})
        self.assertEqual(response.status_code, status.HTTP_200_OK)
        self.assertEqual(len(response.data), 1)  # Only Test Product (99.99)
        self.assertEqual(response.data[0]['name'], 'Test Product')


